%export day12

%import <base>
%import <bfs>
%import <io>
%import <map>           qualified as m
%import <maybe>                         -(>>=) -(<&>) -(>>) -pure -foldM
%import <state>
%import <v2>                            -(>>=) -(<&>) -pure


location == v2 int
grid     == m.map location int

movesFrom :: (int -> int -> bool) -> (location, grid) -> ([location], grid)
movesFrom tst (loc, g)
    = (moves, g)
      where
        dirs      = concat [[V2 d 0, V2 0 d] | d <- [-1, 1]]
        moves     = (filter check . map (v2.add loc)) dirs
        h         = fromMaybe 0 (m.lookup cmplocation loc g)

        check loc
            = False,               if isNothing mh     || not in grid
            = tst h (fromJust mh), otherwise           || passes height difference test
              where
                mh = m.lookup cmplocation loc g

findPath1 :: location -> location -> grid -> [location]
findPath1 start end g
    = path
      where
        (path, _) = bfsSolve cmplocation start (_eq cmplocation end) (movesFrom stepUp) g
        stepUp a b = b <= a + 1

findPath2 :: location -> grid -> [location]
findPath2 start g
    = path
      where
        (path, _)    = bfsSolve cmplocation start isHeight0 (movesFrom stepDown) g
        isHeight0 loc = m.findWithDefault cmplocation (-1) loc g == 0
        stepDown a b  = b >= a - 1

readGrid :: string -> io (grid, location, location)
readGrid fn
    = readFile fn <&> lines <&> go
      where
        go input
            = error "parse error",           if isNothing ms \/ isNothing me
            = (g, fromJust ms, fromJust me), otherwise
              where
                hlist         = [(V2 r c, x) | (r, row) <- enumerate input; (c, x) <- enumerate row]
                (g, (ms, me)) = foldM ins m.empty hlist (Nothing, Nothing)

        ins m (loc, c)
            = (modify . setFst . Just) loc >> ins m (loc, 'a'),      if c ==. 'S'
            = (modify . setSnd . Just) loc >> ins m (loc, 'z'),      if c ==. 'E'
            = pure (m.insert cmplocation loc (code c - code 'a') m), otherwise

day12 :: io ()
day12
    = readGrid "../inputs/day12.txt" >>= go
      where
        go (g, s, e)
            = mapM_ putStrLn [part1, part2]
              where
                part1 = (++) "part 1: " . showint . length . tl . findPath1 s e $ g
                part2 = (++) "part 2: " . showint . length . tl . findPath2 e   $ g
