%export day03

%import <base>
%import <io>
%import <set>           qualified as s


rucksack == (s.set char, s.set char)

(<**>) = s.intersect cmpchar
(<++>) = s.union cmpchar

commonItem :: rucksack -> char
commonItem  (c1, c2) = s.first (c1 <**> c2)

allContents :: rucksack -> s.set char
allContents (c1, c2) = c1 <++> c2

badge :: [rucksack] -> char
badge = s.first . foldl1 (<**>) . map allContents

priority :: char -> int
priority c
    = code c - code 'A' + 27, if isUpper c
    = code c - code 'a' + 1,  otherwise

readRucksacks :: string -> io [rucksack]
readRucksacks fn
    = readFile fn <&> lines <&> map (split2 .> mapBoth (s.fromList cmpchar))

day03 :: io ()
day03
    = readRucksacks "../inputs/day03.txt" >>= go
      where
        go sacks
            = mapM_ putStrLn [part1, part2]
              where
                groups = chunk 3 sacks
                part1  = (++) "part 1: " . showint . sum . map (priority . commonItem) $ sacks
                part2  = (++) "part 2: " . showint . sum . map (priority . badge) $ groups
