|| day02 -- Cube Conundrum


%export day02

%import <base>
%import <io>
%import <maybe>                         -(>>=) -(<&>)
%import <parser>        qualified as p
%import <v3>                            -(>>=) -(<&>) -foldl -sum
%import <v3>            qualified


rgb  == v3 int
game == (int, [rgb])  || game id, list of cube subsets in R,G,B order

|| find the ids of the games that are possible for the given bag config
possibleIdsFrom :: rgb -> [game] -> [int]
possibleIdsFrom config games
    = map fst . filter possible $ games
      where
        a >=? b          = v3.foldr (&) True $ v3.liftA2 (>=) a b
        possible (_, gc) = all (config >=?) gc

|| find the minimum number of r, g, b cubes that would make the game possible
minCubes :: game -> rgb
minCubes (_, gc) = foldl (v3.max cmpint) (v3.pure 0) gc

rgbPower :: rgb -> int
rgbPower v = v3.foldl (*) 1 v

|| parsing
p_colorCount :: p.parser rgb
p_colorCount
    = p.liftA2 mkCount (p.spaces p.>> p.int) (p.spaces p.>> p.some p.letter)
      where
        mkCount n "red"   = V3 n 0 0
        mkCount n "green" = V3 0 n 0
        mkCount n "blue"  = V3 0 0 n
        mkCount n _       = error "bad color"

p_subset :: p.parser rgb
p_subset = p.spaces p.>> p.someSepBy (p.char ',') p_colorCount p.<&> foldl v3.add (v3.pure 0)

p_game :: p.parser game
p_game = p.liftA2 pair (p.string "Game " p.>> p.int) (p.char ':' p.>> p.someSepBy (p.char ';') p_subset) p.<< p.spaces

p_games :: p.parser [game]
p_games = p.someSepBy p.spaces p_game

readGames :: string -> io [game]
readGames fn
    = readFile fn <&> doParse
      where
        doParse input
            = fromMaybe err mgs
              where
                (mgs, ps) = p.parse (p_games p.<< p.end) input
                err       = error (p.error ps)

day02 :: io ()
day02
    = readGames "../inputs/day02.txt" >>= go
      where
        go games
            = mapM_ putStrLn [part1, part2]
              where
                config = V3 12 13 14
                part1  = ("part 1: " ++) . showint . sum . possibleIdsFrom config    $ games
                part2  = ("part 2: " ++) . showint . sum . map (rgbPower . minCubes) $ games
