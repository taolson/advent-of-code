%export day03

%import <base>
%import <io>
%import <map>           qualified as m
%import <maybe>                         -(>>=) -(<&>) -(<*>) -(<<) -(>>) -(<|>)
%import <parser>        qualified as p


point  == (int, int)
fabric == m.map point int

(!!!) :: fabric -> point -> int
f !!! p = fromJust (m.lookup cmppoint p f)

claim ::= Claim int int int int int [point]

cid :: claim -> int
cid (Claim i _ _ _ _ _) = i

points :: claim -> [point]
points (Claim _ _ _ _ _ p) = p

makeClaim :: int -> int -> int -> int -> int -> claim
makeClaim i l t w h
    = Claim i l t w h p
      where
        p = [(x, y) | x <- [l .. l + w - 1]; y <- [t .. t + h - 1]]

mergeClaims :: [claim] -> fabric
mergeClaims
    = foldl mergeClaim m.empty
      where
        mergeClaim f = foldl ins f . points
        ins f k      = m.insertWith cmppoint (+) k 1 f

p_liftA5 f ma mb mc md me = p.liftA4 f ma mb mc md p.<*> me

p_claim :: p.parser claim
p_claim
    = p_liftA5 makeClaim
          (p.char '#' p.>> p.int)
          (p.string " @ " p.>> p.int)
          (p.char ',' p.>> p.int)
          (p.string ": " p.>> p.int)
          (p.char 'x' p.>> p.int)

p_claims :: p.parser [claim]
p_claims = p.some (p_claim p.<< p.spaces)

readClaims :: string -> io [claim]
readClaims fn
    = readFile fn <&> p.parse p_claims <&> go
      where
        go (mclaims, ps) = fromMaybe (error (p.error ps)) mclaims

day03 :: io ()
day03
    = readClaims "../inputs/day03.input" >>= go
      where
        go claims
            = io.mapM_ putStrLn [part1, part2]
              where
                fabric = mergeClaims claims
                part1  = (++) "part 1: " . showint . length . filter (> 1) . m.elems $ fabric
                part2  = (++) "part 2: " . showint . cid . hd . filter (all (== 1) . map (fabric !!!) . points) $ claims
