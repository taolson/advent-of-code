%export day10

%import <base>
%import <io>
%import <lens>
%import <maybe>         as mb           -(>>=) -(<&>) -(<*>) -(<<) -(>>) -(<|>)
%import <parser>        qualified as p
%import <v2>            as v2           -(>>=) -(<&>) -foldl


position == (v2 int)
velocity == (v2 int)

star ::= Star position velocity

s_pos :: star -> position
s_pos (Star p v) = p

moveStar :: star -> star
moveStar (Star p v) = Star (v2.add p v) v


boundingBox == (position, position)

fullBounds :: [position] -> boundingBox
fullBounds [] = error "fullBounds: []"
fullBounds (p : ps)
    = foldl ins (p, p) ps
      where
        ins (lo, hi) p = (v2.min cmpint lo p, v2.max cmpint hi p)

area :: boundingBox -> int
area (lo, hi) = v2.product $ v2.sub hi lo


p_v2int :: p.parser (v2 int)
p_v2int =  p.liftA2 V2 (p.char '<' >> p.spaces >> p.int) (p.char ',' >> p.spaces >> p.int p.<< p.char '>')

p_star :: p.parser star
p_star = p.liftA2 Star (p.string "position=" >> p_v2int p.<< p.spaces) (p.string "velocity=" >> p_v2int p.<< p.spaces)

findLocalMinimum :: (* -> int) -> [*] -> (*, int)
findLocalMinimum f [] = error "findLocalMinimum []"
findLocalMinimum f (x : xs)
    = go 0 (f x) x xs
      where
         go n fx x [] = (x, n)

         go n fx x (y : ys)
            = (x, n),        if fx < fy
            = go n' fy y ys, otherwise
              where
                fy = f y
                n' = n $seq n + 1

showField :: [star] -> string
showField stars
    = go field
      where
        starPos    = map s_pos stars
        (bLo, bHi) = fullBounds $ starPos
        field      = [V2 x y | y <- [viewV2_1 bLo .. viewV2_1 bHi]; x <- [viewV2_0 bLo .. viewV2_0 bHi]]
        lastX      = viewV2_0 bHi

        go [] = []
        go (p : ps)
            = if' (member cmpposition starPos p) '#' '.' :
              if' (viewV2_0 p == lastX) ('\n' : go ps) (go ps)

readStars :: string -> io [star]
readStars fn
    = readFile fn <&> p.parse (p.some p_star) <&> go
      where
        go (mstars, ps) = fromMaybe (error (p.error ps)) mstars

day10 :: io ()
day10
    = readStars "../inputs/day10.input" >>= go
      where
        go stars
            = io.mapM_ putStrLn [part1, part2]
              where
                (mina, time) = findLocalMinimum (area . fullBounds . map s_pos) . iterate (map moveStar) $ stars
                part1 = (++) "part 1:\n" . showField $ mina
                part2 = (++) "part 2: "  . showint $ time
