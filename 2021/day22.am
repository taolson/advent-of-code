%export day22

%import <base>
%import <io>
%import <v2>            -(>>=) -(<&>) -foldl -sum -product
%import <v3>            -(>>=) -(<&>) -foldl -sum -product


r_size, r_lo, r_hi :: v2 int -> int
r_size (V2 l h) = max2 cmpint (h - l + 1) 0
r_lo (V2 l h)   = l
r_hi (V2 l h)   = h

r_intersect :: v2 int -> v2 int -> v2 int
r_intersect (V2 l1 h1) (V2 l2 h2) = V2 (max2 cmpint l1 l2) (min2 cmpint h1 h2)


|| cuboid operations
cuboid == v3 (v2 int)

c_size :: cuboid -> int
c_size (V3 rx ry rz) = product (map r_size [rx, ry, rz])

c_intersect :: cuboid -> cuboid -> cuboid
c_intersect (V3 r1x r1y r1z) (V3 r2x r2y r2z) = V3 (r_intersect r1x r2x) (r_intersect r1y r2y) (r_intersect r1z r2z)

c_difference :: cuboid -> cuboid -> [cuboid]
c_difference c1 c2
    = [c1],                                             if c_size ci == 0
    = [],                                               if _eq cmpcuboid ci c1
    = filter ((> 0) . c_size) [s1, s2, s3, s4, s5, s6], otherwise
      where
        ci              = c_intersect c1 c2
        V3 r1x r1y r1z  = c1
        V2 x1l x1h      = r1x
        V2 y1l y1h      = r1y
        V2 z1l z1h      = r1z

        V3 rix riy riz  = ci
        V2 xil xih      = rix
        V2 yil yih      = riy
        V2 zil zih      = riz

        s1         = V3 (V2 x1l (xil - 1)) r1y               r1z
        s2         = V3 (V2 (xih + 1) x1h) r1y               r1z
        s3         = V3 rix               (V2 y1l (yil - 1)) r1z
        s4         = V3 rix               (V2 (yih + 1) y1h) r1z
        s5         = V3 rix                riy               (V2 z1l (zil - 1))
        s6         = V3 rix                riy               (V2 (zih + 1) z1h)


|| canvas operations
operation ::= Off | On
command   ==  (operation, cuboid)

canvas == [cuboid]

cn_empty :: canvas
cn_empty = []

cn_size :: canvas -> int
cn_size c = map c_size c |> sum

cn_draw :: canvas -> command -> canvas
cn_draw cs (Off, c) =     concatMap ($c_difference c) cs
cn_draw cs (On, c)  = c : concatMap ($c_difference c) cs


readInput :: string -> io [command]
readInput fn
    = readFile fn <&> lines <&> map (words .> readCmd)
      where
        perror s = error ("parse error: " ++ s)

        readCmd ("on" : [xs])  = (On, readCuboid xs)
        readCmd ("off" : [xs]) = (Off, readCuboid xs)
        readCmd xs             = perror "expected a command"

        readCuboid = mkCuboid . map readAxis . split ','

        mkCuboid [a, b, c] = V3 a b c
        mkCuboid xs        = perror "expected 3 ranges for cuboid"

        readAxis = mkRange . map intval . splitWhen isDelim

        isDelim c = 'x' <=. c <=. 'z' \/ c ==. '=' \/ c ==. '.'

        mkRange [lo, hi] = V2 lo hi
        mkRange xs       = perror "bad range"

day22 :: io ()
day22
    = readInput "../inputs/day22.txt" >>= go
      where
        go cmds
            = mapM_ putStrLn [part1, part2]
              where
                initr    = V2 (-50) 50
                initb    = V3 initr initr initr
                initCmds = filter ((> 0) . c_size . c_intersect initb . snd) cmds
                part1    = (++) "part 1: " . showint . cn_size . foldl cn_draw cn_empty $ initCmds
                part2    = (++) "part 2: " . showint . cn_size . foldl cn_draw cn_empty $ cmds
