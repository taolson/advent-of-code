%export day10

%import <base>
%import <io>            (>>=)/(io.>>=)
%import <maybe>
%import "intMap"


computeMissing :: intMap int -> int -> (intMap int, int)
computeMissing mmap span
    = case im_lookup span mmap of
        Nothing      -> computeMissing (grow mmap) span
        Just missing -> (mmap, missing)
      where
        n = im_size mmap
        m = 1 .<<. (n - 3) + sum (im_elems mmap)

        grow mmap = im_insert n m mmap

initMissing :: intMap int
initMissing = im_fromList [(0,0), (1, 0), (2, 0), (3, 1)]

validArrangements :: [int] -> int
validArrangements xs
    = product (zipWith (-) (map pow2 ones) miss)
      where
        deltas    = zipWith (-) xs (0 : xs)
        groups    = group cmpint deltas
        ones      = map ((subtract 1) . length) . filter ((== 1) . hd) $ groups
        (_, miss) = mapAccumL computeMissing initMissing ones
        pow2 n    = 1 .<<. n

joltDistribution :: [int] -> intMap int
joltDistribution
    = snd . foldl addDelta (0, im_empty)
      where
        addDelta (s, hist) n = (n, im_insertWith (+) (n - s) 1 hist)

day10 :: io ()
day10
    = readFile "../inputs/day10.txt" >>= lines .> map intval .> go
      where
        go input
            = io.mapM_ putStrLn [part1, part2]
              where
                target   = max cmpint input + 3
                adapters = sortBy cmpint (target : input)
                hist     = joltDistribution adapters
                part1    = (++) "part 1: " . showint $ getCount 1 * getCount 3
                part2    = (++) "part 2: " . showint $ validArrangements adapters

                getCount n = im_findWithDefault 0 n hist