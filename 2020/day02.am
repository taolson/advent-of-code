%export day02

%import <base>
%import <io>
%import <maybe>                         -(>>=) -(<&>)
%import <parser>        qualified as p

password ::= Password int int char string

valid1 :: password -> bool
valid1 (Password minc maxc req pass)
    = minc <= count <= maxc
      where
        count = length . filter (==. req) $ pass

valid2 :: password -> bool
valid2 (Password p1 p2 req pass)
    = valid p1 $xor valid p2
      where
        len      = #pass
        valid p  = 0 <= p <= len & pass ! (p - 1) ==. req

p_password :: p.parser password
p_password
    = p.liftA4 Password
      (p.posint p.<< p.char '-')
      (p.posint p.<< p.spaces)
      (p.any p.<< p.char ':' p.<< p.spaces)
      (p.many p.letter p.<< p.spaces)

readPasswords :: string -> io [password]
readPasswords fn
    = readFile fn <&> go
      where
        go input
            = fromMaybe err mps
              where
                (mps, ps) = p.parse (p.many p_password) input
                err       = error (p.error ps)

day02 :: io ()
day02
    = readPasswords "../inputs/day02.txt" >>= go
      where
        go passwords
            = mapM_ putStrLn [part1, part2]
              where
                part1 = (++) "part 1: " . showint . length . filter valid1 $ passwords
                part2 = (++) "part 2: " . showint . length . filter valid2 $ passwords
