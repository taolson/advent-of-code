%export day03

%import <base>
%import <io>
%import <set>           qualified as s

point == (int, int)
grid  ::= Grid (s.set point) int int

treeCount :: grid -> point -> int
treeCount (Grid trees maxX maxY) (slopeX, slopeY)
    = sum . map countTree $ steps
      where
        countTree pt     = if' (s.member cmppoint pt trees) 1 0
        steps            = takeWhile ((< maxY) . snd) . iterate stepSlope $ (0, 0)
        stepSlope (x, y) = ((x + slopeX) $mod maxX, y + slopeY)

readGrid :: string -> io grid
readGrid fn
    = readFile fn <&> lines <&> go
      where
        go rows
            = Grid trees maxX maxY
              where
                trees = s.fromList cmppoint [(x, y) | (y, row) <- enumerate rows; (x, col) <- enumerate row; col ==. '#']
                maxX  = length . hd $ rows
                maxY  = length rows

day03 :: io ()
day03
    = readGrid "../inputs/day03.txt" >>= go
      where
        go grid
            = mapM_ putStrLn [part1, part2]
              where
                slopes = [(1, 1), (3, 1), (5, 1), (7, 1), (1, 2)]
                part1  = (++) "part 1: " . showint $ treeCount grid (3, 1)
                part2  = (++) "part 2: " . showint . product . map (treeCount grid) $ slopes
